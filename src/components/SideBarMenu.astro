---
const { sideBarActiveItemID } = Astro.props;

const items = [
  { id: "home", href: "/", label: "首页" },
  { id: "note", href: "/note", label: "笔记" },
  { id: "blog", href: "/blog/", label: "日记" },
  { id: "archives", href: "/archives", label: "归档" },
  { id: "tags", href: "/tags", label: "标签" },
];
---

<nav class="grow overflow-y-auto" aria-label="主导航">
  <ul class="menu menu-md gap-1">
    {
      items.map((item) => {
        const isActive = sideBarActiveItemID === item.id;
        return (
          <li>
            <a
              id={item.id}
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "py-3 text-base transition",
                isActive && "bg-base-300 font-medium text-base-content",
              ]}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
