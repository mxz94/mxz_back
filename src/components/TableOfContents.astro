<script type="module">
  function createTocLink(heading) {
    const link = document.createElement('a');
    link.href = `#${heading.id}`;

    const dot = document.createElement('span');
    dot.className = 'box';
    dot.setAttribute('aria-hidden', 'true');

    const text = document.createElement('span');
    text.textContent = heading.textContent || '';

    link.append(dot, text);
    return link;
  }

  function setupToc() {
    if (document.querySelector('.toc-wrapper')) return;

    const article = document.querySelector('article');
    if (!article) return;

    const headings = Array.from(article.querySelectorAll('h2, h3, h4, h5, h6'))
      .filter((heading) => !heading.classList.contains('title') && heading.textContent?.trim());

    if (headings.length < 2) return;

    const tocWrapper = document.createElement('aside');
    tocWrapper.className = 'toc-wrapper';
    tocWrapper.setAttribute('aria-label', '目录');

    const tocInner = document.createElement('div');
    tocInner.className = 'toc-inner';

    const tocHead = document.createElement('div');
    tocHead.className = 'toc-head';

    const tocTitle = document.createElement('b');
    tocTitle.className = 'toc-head-title';
    tocTitle.textContent = '目录';

    const topLink = document.createElement('a');
    topLink.className = 'toc-head-top';
    topLink.href = '#';
    topLink.textContent = '↑ 顶部';
    topLink.addEventListener('click', (event) => {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    tocHead.append(tocTitle, topLink);

    const tocContent = document.createElement('div');
    tocContent.className = 'toc';

    const rootList = document.createElement('ul');
    const stack = [{ level: 2, list: rootList }];

    headings.forEach((heading, index) => {
      if (!heading.id) {
        heading.id = `toc-${index}-${heading.textContent.trim().toLowerCase().replace(/\s+/g, '-')}`;
      }

      const level = Math.min(Number(heading.tagName.substring(1)), 6);
      const listItem = document.createElement('li');
      listItem.appendChild(createTocLink(heading));

      while (stack.length > 1 && level <= stack[stack.length - 1].level) {
        stack.pop();
      }

      if (level > stack[stack.length - 1].level) {
        const nestedList = document.createElement('ul');
        const parentItem = stack[stack.length - 1].list.lastElementChild;
        if (parentItem) {
          parentItem.appendChild(nestedList);
          stack.push({ level, list: nestedList });
        }
      }

      stack[stack.length - 1].list.appendChild(listItem);
    });

    tocContent.appendChild(rootList);
    tocInner.append(tocHead, tocContent);
    tocWrapper.appendChild(tocInner);
    document.body.appendChild(tocWrapper);

    const links = tocWrapper.querySelectorAll('a[href^="#toc-"], a[href^="#"]');
    const setActive = (id) => {
      tocWrapper.querySelectorAll('li.active').forEach((item) => item.classList.remove('active'));
      const activeLink = tocWrapper.querySelector(`a[href="#${CSS.escape(id)}"]`);
      activeLink?.parentElement?.classList.add('active');
    };

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const targetId = link.getAttribute('href')?.slice(1);
        if (!targetId) return;

        const target = document.getElementById(targetId);
        if (!target) return;

        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', `#${targetId}`);
        setActive(targetId);
      });
    });

    const observer = new IntersectionObserver((entries) => {
      const visible = entries.find((entry) => entry.isIntersecting);
      if (visible?.target?.id) {
        setActive(visible.target.id);
      }
    }, { rootMargin: '-42% 0% -52% 0%' });

    headings.forEach((heading) => observer.observe(heading));
  }

  const scheduleToc = () => {
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(setupToc, { timeout: 1200 });
    } else {
      window.requestAnimationFrame(setupToc);
    }
  };

  scheduleToc();
  document.addEventListener('astro:page-load', scheduleToc);
</script>
