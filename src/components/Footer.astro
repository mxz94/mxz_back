---
import { SITE } from "../config";

const today = new Date();
const siteStart = new Date(SITE.siteTime);
const runningDays = Math.max(
  0,
  Math.floor((today.getTime() - siteStart.getTime()) / (24 * 60 * 60 * 1000))
);
---

<footer class="footer-center block mb-5 pt-10 text-sm text-base-content/70">
  <div class="pb-2">
    <a href={"https://mdd." + SITE.website.split("://")[1] + "/keystatic"}>
      Copyright &copy; {today.getFullYear()} write on {SITE.author}
    </a>
  </div>
  <div class="inline opacity-75">
    <span class="font-bold">本站已运行 {runningDays} 天</span>
  </div>
</footer>
