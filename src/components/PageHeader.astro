---
interface Props {
  title: string;
  description?: string;
  count?: string | number;
}

const { title, description, count } = Astro.props;
---

<header class="mb-5 sm:mb-6">
  <div class="flex flex-wrap items-end justify-between gap-3 border-b border-base-300 pb-3.5 sm:pb-4">
    <div class="min-w-0">
      <h1 class="m-0 text-3xl font-bold leading-tight text-base-content sm:text-4xl">
        {title}
      </h1>
      {
        description && (
          <p class="mt-2 max-w-2xl text-sm leading-6 text-base-content/60 sm:text-base">
            {description}
          </p>
        )
      }
    </div>
    {
      count !== undefined && (
        <span class="rounded-full border border-base-300 px-3 py-1 text-sm text-base-content/60">
          {count}
        </span>
      )
    }
  </div>
</header>
