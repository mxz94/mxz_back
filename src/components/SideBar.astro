---
import SideBarFooter from "./SideBarFooter.astro";
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="sidebar-shell flex h-auto min-h-full w-[16rem] flex-col border-r border-base-300 bg-base-200/80 px-3 py-3 text-base-content backdrop-blur">
    <div class="sidebar-top mb-5 flex items-center gap-2">
      <a href="/" class="sidebar-profile flex min-w-0 grow items-center gap-3 rounded-lg px-2 py-2 no-underline transition hover:bg-base-300/70">
        <Image
          class="sidebar-avatar h-12 w-12 shrink-0 rounded-full object-cover"
          format="webp"
          width={96}
          height={96}
          src="/logo.png"
          alt="Profile image"
        />
        <span class="sidebar-label min-w-0">
          <span class="block truncate text-sm font-semibold leading-5">Mxz's Blog</span>
          <span class="block truncate text-xs leading-5 text-base-content/55">日常和笔记</span>
        </span>
      </a>
      <button
        type="button"
        class="sidebar-toggle btn btn-ghost btn-sm hidden h-9 w-9 shrink-0 rounded-lg p-0 lg:inline-flex"
        data-sidebar-toggle
        aria-label="收起侧边栏"
        aria-expanded="true"
        title="收起侧边栏"
      >
        <svg class="sidebar-toggle-icon h-4 w-4 transition-transform" aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <div class="sidebar-footer">
      <SideBarFooter />
    </div>
  </aside>
</div>
