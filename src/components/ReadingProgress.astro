<div class="reading-progress" id="progress-bar" aria-hidden="true"></div>

<script>
  function initReadingProgress() {
    const bar = document.getElementById("progress-bar");
    if (!bar || bar.dataset.initialized === "true") return;
    bar.dataset.initialized = "true";

    let ticking = false;

    function update() {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? window.scrollY / scrollable : 0;
      bar.style.width = `${Math.min(ratio * 100, 100)}%`;
      ticking = false;
    }

    function requestUpdate() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }

    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate, { passive: true });
    update();
  }

  initReadingProgress();
  document.addEventListener("astro:page-load", initReadingProgress);
</script>
