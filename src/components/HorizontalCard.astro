---
const { title, img, desc, url, badge, tags = [], priority = false } = Astro.props;
const imageLoading = priority ? "eager" : "lazy";
const imageFetchPriority = priority ? "high" : undefined;
const visibleTags = tags.slice(0, 2);
const displayDate = Astro.props.pubDatetime
  ? new Date(Astro.props.pubDatetime).toISOString().slice(0, 10)
  : undefined;

// 列表里的图只显示 136px 宽，原图动辄几百 KB。
// 优先用预先生成的 400px 缩略图（scripts/gen-thumbs.mjs），
// 万一缩略图缺失就回退到原图。
const thumb =
  img && img.startsWith("/img/")
    ? "/thumb/" + img.slice(5).replace(/\.(jpe?g|png|webp)$/i, ".webp")
    : img;
---

<li class="post-item reveal">
  <a class="post-link" href={url}>
    <div class="post-body">
      <div class="post-meta">
        {displayDate && <time datetime={displayDate}>{displayDate}</time>}
        {badge && <span>· {badge}</span>}
        {
          visibleTags.length > 0 && (
            <span style="margin-left:auto">{visibleTags.join(" · ")}</span>
          )
        }
      </div>
      <h2 class="post-title">{title}</h2>
      {desc && <p class="post-desc">{desc}</p>}
    </div>
    {
      img && (
        <div class="post-thumb">
          <img
            src={thumb}
            width="400"
            height="300"
            alt=""
            loading={imageLoading}
            fetchpriority={imageFetchPriority}
            decoding="async"
            onerror={`this.onerror=null;this.src=${JSON.stringify(img)}`}
          />
        </div>
      )
    }
  </a>
</li>
