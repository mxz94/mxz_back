---
const { title, img, desc, url, badge, tags, target = "_blank", priority = false } = Astro.props;
const imageLoading = priority ? "eager" : "lazy";
const imageFetchPriority = priority ? "high" : undefined;
import { Image } from "astro:assets";
---

<article class="group rounded-lg border border-base-200 bg-base-100/90 transition hover:border-base-300 hover:bg-base-100 hover:shadow-sm">
  <div class="flex gap-4 p-3.5 sm:gap-5 sm:p-4">
    {
      img && (
        <a href={url} target={target} class="block w-28 shrink-0 overflow-hidden rounded-lg sm:w-36 md:w-44 lg:w-48">
          <Image
            src={img}
            width={384}
            height={384}
            format="webp"
            alt={title}
            loading={imageLoading}
            fetchpriority={imageFetchPriority}
            decoding="async"
            class="aspect-square w-full rounded-lg object-cover transition duration-200 group-hover:scale-[1.015]"
            widths={[192, 288, 384]}
            sizes="(max-width: 640px) 112px, (max-width: 768px) 144px, (max-width: 1024px) 176px, 192px"
          />
        </a>
      )
    }
    <div class="min-w-0 grow">
      <div class="flex items-start gap-2">
        <h2 class="m-0 min-w-0 text-lg font-semibold leading-snug sm:flex-1 sm:text-xl">
          <a href={url} target={target} class="hover:underline">
            {title}
          </a>
          {badge && <span class="badge badge-secondary badge-sm ml-2 align-middle">{badge}</span>}
        </h2>
        {
          tags && tags.length > 0 && (
            <div class="ml-auto flex max-w-[42%] shrink-0 flex-wrap justify-end gap-1 pt-0.5 sm:max-w-[45%]">
              {tags.map((tag) => (
                <a
                  href={`/tag/${tag}`}
                  class="badge badge-outline badge-sm h-auto min-h-0 px-2 py-0.5 text-[11px] leading-tight no-underline"
                >
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
      <a href={url} target={target} class="block">
        <p class="mt-2 line-clamp-3 text-sm leading-7 text-base-content/75 sm:text-base">{desc}</p>
      </a>
    </div>
  </div>
</article>
