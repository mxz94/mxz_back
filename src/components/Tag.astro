---
export interface Props {
  name: string;
  size?: "sm" | "lg";
  count?: number;
}

const { name, size = "sm", count } = Astro.props;
const isLarge = size === "lg";
---

<li class="inline-flex">
  <a
    href={`/tag/${name.toLowerCase()}`}
    class:list={[
      "group inline-flex items-center gap-2 rounded-full border border-base-300 bg-base-100 text-base-content/75 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-base-content/20 hover:bg-base-200 hover:text-base-content focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
      isLarge ? "px-4 py-2 text-base" : "px-3 py-1.5 text-sm",
    ]}
  >
    <span>#{name.toLowerCase()}</span>
    {
      count !== undefined && (
        <span class="rounded-full bg-base-200 px-2 py-0.5 text-xs text-base-content/60 group-hover:bg-base-100">
          {count}
        </span>
      )
    }
  </a>
</li>
