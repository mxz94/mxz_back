---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import BackToTop from "../components/BackToTop.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

const { image, title = SITE_TITLE, description = SITE_DESCRIPTION, includeSidebar = true, sideBarActiveItemID,ogType } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="lofi">
  <head>
      <meta charset="utf-8"/>
      <meta name="msvalidate.01" content="554974539F0479DABBAF2B9C6886C920" />
      <meta name="baidu-site-verification" content="codeva-Zb1fJaVwQk" />
    <BaseHead title={title} description={description} image={image} , ogType={ogType} />
    <script is:inline>
      try {
        if (localStorage.getItem('mxz-sidebar-collapsed') === 'true') {
          document.documentElement.classList.add('sidebar-collapsed-init');
        }
      } catch {
        // localStorage can be unavailable in strict browser modes.
      }
    </script>
  </head>
  <body>
    <div class="site-drawer bg-base-100 drawer lg:drawer-open" data-layout-drawer>
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />
      <div class="drawer-content bg-base-100">
        <Header title={SITE_TITLE} />
        <div class="flex justify-center">
          <main class="site-main w-full px-4 py-8 sm:px-6 lg:px-8 xl:px-10">
            <slot />
          </main>
        </div>
        <Footer />
      </div>
      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>
    <BackToTop />
    
    <script>
      // Prevent background scroll when mobile drawer is open
      function initDrawerScrollLock() {
        const drawer = document.getElementById('my-drawer');
        if (!drawer) return;
        if (drawer.dataset.scrollLockInitialized === 'true') return;
        drawer.dataset.scrollLockInitialized = 'true';

        let scrollPosition = 0;

        drawer.addEventListener('change', (e) => {
          if (e.target.checked) {
            // Drawer is open - lock body scroll
            scrollPosition = window.pageYOffset;
            document.body.style.position = 'fixed';
            document.body.style.top = `-${scrollPosition}px`;
            document.body.style.width = '100%';
            document.body.style.overflow = 'hidden';
            document.documentElement.style.overflow = 'hidden';
          } else {
            // Drawer is closed - unlock body scroll
            document.body.style.position = '';
            document.body.style.top = '';
            document.body.style.width = '';
            document.body.style.overflow = '';
            document.documentElement.style.overflow = '';
            window.scrollTo(0, scrollPosition);
          }
        });
      }

      // Initialize on page load
      initDrawerScrollLock();

      // Re-initialize on Astro page transitions
      document.addEventListener('astro:page-load', initDrawerScrollLock);

      function initSidebarCollapse() {
        const drawer = document.querySelector('[data-layout-drawer]');
        const toggle = document.querySelector('[data-sidebar-toggle]');
        if (!drawer || !toggle) return;
        if (toggle.dataset.initialized === 'true') return;
        toggle.dataset.initialized = 'true';

        const storageKey = 'mxz-sidebar-collapsed';
        const setCollapsed = (collapsed) => {
          drawer.classList.toggle('sidebar-collapsed', collapsed);
          document.documentElement.classList.toggle('sidebar-collapsed-init', collapsed);
          toggle.setAttribute('aria-expanded', String(!collapsed));
          toggle.setAttribute('title', collapsed ? '展开侧边栏' : '收起侧边栏');
        };

        let storedCollapsed = false;
        try {
          storedCollapsed = localStorage.getItem(storageKey) === 'true';
        } catch {
          storedCollapsed = document.documentElement.classList.contains('sidebar-collapsed-init');
        }

        setCollapsed(storedCollapsed);

        toggle.addEventListener('click', () => {
          const collapsed = !drawer.classList.contains('sidebar-collapsed');
          setCollapsed(collapsed);
          try {
            localStorage.setItem(storageKey, String(collapsed));
          } catch {
            // Ignore storage failures; the current view still updates.
          }
        });
      }

      initSidebarCollapse();
      document.addEventListener('astro:page-load', initSidebarCollapse);
    </script>
  </body>
</html>
