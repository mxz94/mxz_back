---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Pagination from "../../components/Pagination.astro";
import MovieCard from "../../components/MovieCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import data from "/public/douban/movie.json";

export async function getStaticPaths({ paginate }) {
  return paginate(data, { pageSize: 10 });
}

const { page } = Astro.props;
const firstPage = page.url.prev ? "/move" : null;
const lastPage = page.url.next ? `/move/${page.lastPage}` : null;
---

<BaseLayout title="电影" sideBarActiveItemID="move">
  <PageHeader title="我看过的电影" description="看过的片子和当时留下的一点记录。" count={`${page.total} 部`} />
  {
    page.data.length === 0 ? (
      <div class="rounded-lg border border-base-300 bg-base-100 p-5 text-base-content/70">
        <p class="font-semibold text-base-content">暂时还没有内容</p>
        <p class="mt-1 text-sm">之后再回来看看。</p>
      </div>
    ) : (
      <div class="space-y-3">
        {page.data.map((movie) => (
          <MovieCard {...movie} />
        ))}
      </div>
    )
  }
  {
    page.lastPage > 1 && (
      <Pagination
        firstPage={firstPage}
        previousPage={page.url.prev}
        nextPage={page.url.next}
        lastPage={lastPage}
        currentPage={page.currentPage}
        totalPages={page.lastPage}
      />
    )
  }
</BaseLayout>
