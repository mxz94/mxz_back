---
import { CollectionEntry } from "astro:content";
import { BlogSchema } from "../../content/config";
import PostLayout from "../../layouts/PostLayout.astro";
import { getPublicBlogs } from "../../utils";
import getHeroImageLinkFromMd from "../../utils/getHeroImageLinkFromMd";

export async function getStaticPaths() {
  const postEntries = await getPublicBlogs();
  return postEntries.map((entry, idx) => {
      const prev = postEntries[idx - 1]
      const next = postEntries[idx + 1]
      return {
          params: { slug: entry.slug },
          props: { entry, next, prev },
      }
  });
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry, prev, next } = Astro.props;
const post: BlogSchema = entry.data;
const heroImage = getHeroImageLinkFromMd(entry.body)
const hasCode = entry.body.includes("```");
const hasToc = /^#{2,6}\s/m.test(entry.body);
const hasArticleMedia = /!\[[^\]]*]\([^)]*\)|<img\b|<picture\b|<video\b|<iframe\b|!bv\{/i.test(entry.body);
const { Content } = await entry.render();
---

<PostLayout
  title={post.title}
  description={post.description}
  pubDatetime={post.pubDatetime}
  heroImage={heroImage}
  updatedDate={post.updatedDate}
  badge={post.badge}
  tags={post.tags}
  type = "blog"
  hasCode={hasCode}
  hasToc={hasToc}
  hasArticleMedia={hasArticleMedia}
>
  <Content />
    <nav class="post-nav" aria-label="上下篇">
    {
      prev && (
        <a href={`/blog/${prev.slug}/`}>
          <span class="dir">上一篇</span>
          {prev.data.title}
        </a>
      )
    }
    {
      next && (
        <a href={`/blog/${next.slug}/`} style="text-align:right">
          <span class="dir">下一篇</span>
          {next.data.title}
        </a>
      )
    }
  </nav>
</PostLayout>
