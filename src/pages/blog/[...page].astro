---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import Pagination from "@components/Pagination.astro";
import { getPublicBlogs } from "../../utils";
import { buildPostListItems } from "../../utils/postList";

export async function getStaticPaths({ paginate }) {
  const posts = await getPublicBlogs();
  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props;
const firstPage = page.url.prev ? "/blog/" : null;
const lastPage = page.url.next ? `/blog/${page.lastPage}` : null;
const postItems = buildPostListItems(page.data);
---

<BaseLayout title="日记">
  <h1 class="page-title">日记</h1>
  <p class="page-desc">共 {page.total} 篇，按时间倒序。</p>

  {
    page.data.length === 0 ? (
      <p class="page-desc" style="margin-top:2rem">暂时还没有内容。</p>
    ) : (
      <ul class="post-list" id="post-list">
        {postItems.map(({ post, img, desc, url, priority }) => (
          <HorizontalCard
            title={post.data.title}
            img={img}
            desc={desc}
            url={url}
            badge={post.data.badge}
            tags={post.data.tags}
            pubDatetime={post.data.pubDatetime}
            priority={priority}
          />
        ))}
      </ul>
    )
  }

  <div
    id="infinite-sentinel"
    data-next={page.url.next || ""}
    aria-live="polite"
  >
    {
      page.url.next ? (
        <span class="infinite-hint">下滑加载更多</span>
      ) : (
        <span class="infinite-end">· 已经到底了 ·</span>
      )
    }
  </div>

  <noscript>
    {
      page.lastPage > 1 && (
        <Pagination
          firstPage={firstPage}
          previousPage={page.url.prev}
          nextPage={page.url.next}
          lastPage={lastPage}
          currentPage={page.currentPage}
          totalPages={page.lastPage}
        />
      )
    }
  </noscript>
</BaseLayout>
