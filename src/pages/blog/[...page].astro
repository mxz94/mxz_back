---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import suppDesc from "../../utils/suppDesc";
import createSlug from "../../utils/createSlug";
import Pagination from "../../components/Pagination.astro";
import getHeroImageLinkFromMd from "../../utils/getHeroImageLinkFromMd";

export async function getStaticPaths({ paginate }) {
  let posts = await getCollection("blog");
  posts = posts.filter((item) => !item.data.auth);
  posts.sort((a, b) => b.data.pubDatetime.valueOf() - a.data.pubDatetime.valueOf());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
const firstPage = page.url.prev ? "/blog" : null;
const lastPage = page.url.next ? `/blog/${page.lastPage}` : null;
let priorityImageCount = 0;
const postItems = page.data.map((post) => {
  const img = getHeroImageLinkFromMd(post);
  const priority = Boolean(img) && priorityImageCount < 2;
  if (img) priorityImageCount += 1;

  return { post, img, priority };
});
---

<BaseLayout title="日记" sideBarActiveItemID="blog">
  <PageHeader title="日记" description="按时间收着生活里的片段和念头。" count={`${page.total} 篇`} />

  {
    page.data.length === 0 ? (
      <div class="rounded-lg border border-base-300 bg-base-100 p-5 text-base-content/70">
        <p class="font-semibold text-base-content">暂时还没有内容</p>
        <p class="mt-1 text-sm">之后再回来看看。</p>
      </div>
    ) : (
      <div class="space-y-3">
        {postItems.map(({ post, img, priority }) => (
          <HorizontalCard
            title={post.data.title}
            img={img}
            desc={suppDesc(post.data.description, post.body)}
            url={createSlug(post)}
            target="_self"
            badge={post.data.badge}
            tags={post.data.tags}
            priority={priority}
          />
        ))}
      </div>
    )
  }

  {
    page.lastPage > 1 && (
      <Pagination
        firstPage={firstPage}
        previousPage={page.url.prev}
        nextPage={page.url.next}
        lastPage={lastPage}
        currentPage={page.currentPage}
        totalPages={page.lastPage}
      />
    )
  }
</BaseLayout>
