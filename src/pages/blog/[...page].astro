---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";
import Pagination from "../../components/Pagination.astro";
import { buildPostListItems, sortPostsByDate } from "../../utils/postList";

export async function getStaticPaths({ paginate }) {
  let posts = await getCollection("blog");
  posts = posts.filter((item) => !item.data.auth);
  return paginate(sortPostsByDate(posts), { pageSize: 10 });
}

const { page } = Astro.props;
const firstPage = page.url.prev ? "/blog" : null;
const lastPage = page.url.next ? `/blog/${page.lastPage}` : null;
const postItems = buildPostListItems(page.data);
---

<BaseLayout title="日记" sideBarActiveItemID="blog">
  <PageHeader title="日记" description="按时间收着生活里的片段和念头。" count={`${page.total} 篇`} />

  {
    page.data.length === 0 ? (
      <div class="rounded-lg border border-base-300 bg-base-100 p-5 text-base-content/70">
        <p class="font-semibold text-base-content">暂时还没有内容</p>
        <p class="mt-1 text-sm">之后再回来看看。</p>
      </div>
    ) : (
      <div class="grid gap-3 2xl:grid-cols-2">
        {postItems.map(({ post, img, desc, url, priority }) => (
          <HorizontalCard
            title={post.data.title}
            img={img}
            desc={desc}
            url={url}
            target="_self"
            badge={post.data.badge}
            tags={post.data.tags}
            priority={priority}
          />
        ))}
      </div>
    )
  }

  {
    page.lastPage > 1 && (
      <Pagination
        firstPage={firstPage}
        previousPage={page.url.prev}
        nextPage={page.url.next}
        lastPage={lastPage}
        currentPage={page.currentPage}
        totalPages={page.lastPage}
      />
    )
  }
</BaseLayout>
