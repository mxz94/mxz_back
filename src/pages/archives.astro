---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import data from "/public/douban/movie.json";

const movieCover = data[0]?.subject?.cover_url ?? "/img/cover/2026.webp";

const years = [
  { title: "二零二六", desc: "年度词：健康", href: "/blog/archives/2026", img: "/img/cover/2026.webp" },
  { title: "二零二五", desc: "年度词：改变，运动", href: "/blog/archives/2025", img: "/img/cover/2025.webp" },
  { title: "二零二四", desc: "年度词：孩子", href: "/blog/archives/2024", img: "/img/cover/2024.webp" },
  { title: "二零二三", desc: "年度词：成长", href: "/blog/archives/2023", img: "/img/cover/2023.webp" },
  { title: "二零二二", desc: "年度词：家庭", href: "/blog/archives/2022", img: "/img/cover/2022.webp" },
  { title: "二零二一", desc: "年度词：陪伴", href: "/blog/archives/2021", img: "/img/cover/2021.webp" },
  { title: "二零二零", desc: "年度词：工作", href: "/blog/archives/2020", img: "/img/cover/2020.webp" },
  { title: "二零一九", desc: "年度词：目标", href: "/blog/archives/2019", img: "/img/cover/2019.webp" },
];

const collections = [
  { title: "成长日记", desc: "兰汐", href: "/blog/archives/成长日记", img: "/img/cover/child2.webp" },
  { title: "朝花夕拾", desc: "朝花夕拾", href: "/blog/archives/朝花夕拾", img: "/img/cover/朝花夕拾.webp" },
  { title: "看过的电影", desc: `已看过 ${data.length} 部`, href: "/move", img: movieCover },
];

const albums = [
  { title: "孩子", href: "https://photos.app.goo.gl/BRJnpup68WtWKQXo7" },
  { title: "足迹", href: "https://photos.app.goo.gl/pqPnNBxxSL63T4wXA" },
  { title: "健身", href: "https://photos.app.goo.gl/wmWsr1Nxtf75Uz8R8" },
];
---

<BaseLayout title="归档" wide>
  <h1 class="page-title">归档</h1>
  <p class="page-desc">按年份、主题和相册翻。</p>

  <h2 class="section-label">按年份</h2>
  <div class="card-grid">
    {
      years.map((item) => (
        <a class="year-card" href={item.href}>
          <Image
            src={item.img}
            width={640}
            height={360}
            format="webp"
            alt={item.title}
            loading="lazy"
            decoding="async"
            widths={[640]}
            sizes="(max-width: 640px) calc(100vw - 2.2rem), 380px"
            style="aspect-ratio:16/9;width:100%;object-fit:cover;border-radius:10px;margin-bottom:.75rem"
          />
          <div class="year-card-title">{item.title}</div>
          <div class="year-card-desc">{item.desc}</div>
        </a>
      ))
    }
  </div>

  <h2 class="section-label">按主题</h2>
  <div class="card-grid">
    {
      collections.map((item) => (
        <a class="year-card" href={item.href}>
          <Image
            src={item.img}
            width={640}
            height={360}
            format="webp"
            alt={item.title}
            loading="lazy"
            decoding="async"
            widths={[640]}
            sizes="(max-width: 640px) calc(100vw - 2.2rem), 380px"
            style="aspect-ratio:16/9;width:100%;object-fit:cover;border-radius:10px;margin-bottom:.75rem"
          />
          <div class="year-card-title">{item.title}</div>
          <div class="year-card-desc">{item.desc}</div>
        </a>
      ))
    }
  </div>

  <h2 class="section-label">相册</h2>
  <ul class="tag-list">
    {
      albums.map((item) => (
        <li>
          <a class="tag tag--lg" href={item.href} target="_blank" rel="noreferrer">
            {item.title}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
