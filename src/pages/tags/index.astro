---
import { getPublicAllPosts } from "../../utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import getUniqueTags from "../../utils/getUniqueTags";

const posts = await getPublicAllPosts();
const { tags, tagCounts } = getUniqueTags(posts);
const sorted = [...tags].sort(
  (a, b) => tagCounts[b] - tagCounts[a] || a.localeCompare(b)
);
---

<BaseLayout title="标签">
  <h1 class="page-title">标签</h1>
  <p class="page-desc">共 {tags.length} 个标签，按篇数排列。</p>

  <ul class="tag-list" style="margin-top:1.75rem">
    {
      sorted.map((tag) => (
        <li>
          <a class="tag tag--lg" href={`/tag/${tag}/`}>
            {tag}
            <span class="tag-count">{tagCounts[tag]}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
