---
import { getAllPosts } from "../../utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import getUniqueTags from "../../utils/getUniqueTags";
import Tag from "@components/Tag.astro";

const posts = await getAllPosts();
const { tags, tagCounts } = getUniqueTags(posts);

---

<BaseLayout title="标签" sideBarActiveItemID="tags">
  <PageHeader title="标签" description="按主题翻找文章，数量越多越容易被重新遇见。" count={`${tags.length} 个`} />
  <ul class="flex flex-wrap gap-3">
    {tags.map((tag) => <Tag name={tag} size="lg" count={tagCounts[tag]} />)}
  </ul>
</BaseLayout>
