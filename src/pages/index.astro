---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import suppDesc from "../utils/suppDesc";
import createSlug from "../utils/createSlug";
import { getBlogs, getNotes } from "../utils";
import getHeroImageLinkFromMd from "../utils/getHeroImageLinkFromMd";

const notes = await getNotes();
const blogs = await getBlogs();

const sections = [
  {
    title: "最近笔记",
    description: "整理技术、工具和日常折腾里留下来的记录。",
    href: "/note",
    posts: notes.slice(0, 6),
  },
  {
    title: "最近日记",
    description: "一些更生活化的片段，慢慢放在这里。",
    href: "/blog",
    posts: blogs.slice(0, 6),
  },
];

const getHomePostClass = (index) => {
  if (index < 3) return "";
  if (index < 4) return "hidden lg:block";
  return "hidden 2xl:block";
};

let priorityImageCount = 0;
const listSections = sections.map((section) => ({
  ...section,
  posts: section.posts.map((post) => {
    const img = getHeroImageLinkFromMd(post);
    const priority = Boolean(img) && priorityImageCount < 2;
    if (img) priorityImageCount += 1;

    return { post, img, priority };
  }),
}));
---

<BaseLayout sideBarActiveItemID="home">
  <div class="grid gap-8 xl:grid-cols-2 xl:gap-7">
    {
      listSections.map((section) => (
        <section class="min-w-0">
          <div class="mb-5 flex items-end justify-between gap-4">
            <div>
              <h2 class="m-0 text-3xl font-bold leading-tight text-base-content">{section.title}</h2>
              <p class="mt-2 text-sm leading-6 text-base-content/60">{section.description}</p>
            </div>
            <a href={section.href} class="btn btn-ghost btn-sm gap-1" aria-label={`查看更多${section.title}`}>
              更多
              <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
          <div class="grid gap-3">
            {section.posts.map(({ post, img, priority }, index) => (
              <div class={getHomePostClass(index)}>
                <HorizontalCard
                  title={post.data.title}
                  img={img}
                  desc={suppDesc(post.data.description, post.body)}
                  url={createSlug(post)}
                  target="_self"
                  badge={post.data.badge}
                  tags={post.data.tags}
                  priority={priority}
                />
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
