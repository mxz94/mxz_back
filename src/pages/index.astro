---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getPublicBlogs } from "../utils";
import { buildPostListItems } from "../utils/postList";
import getUniqueTags from "../utils/getUniqueTags";
import { SITE } from "../config";
import dayjs from "dayjs";

const blogs = await getPublicBlogs();
const items = buildPostListItems(blogs.slice(0, 9));
const featured = items[0];
const posts = items.slice(1);
const { tags, tagCounts } = getUniqueTags(blogs);
const popularTags = [...tags]
  .sort((tagA, tagB) => tagCounts[tagB] - tagCounts[tagA] || tagA.localeCompare(tagB))
  .slice(0, 10);

const latest = items[0]?.post.data.pubDatetime;
const lastUpdate = latest ? dayjs(latest).format("YYYY-MM-DD") : "—";
const firstYear = blogs.length
  ? dayjs(
      blogs.reduce(
        (min, post) =>
          post.data.pubDatetime && post.data.pubDatetime < min
            ? post.data.pubDatetime
            : min,
        blogs[0].data.pubDatetime ?? new Date()
      )
    ).format("YYYY")
  : "—";
---

<BaseLayout>
  <section class="home-hero reveal">
    <h1 class="hero-title">{SITE.desc}的日记</h1>
    <p class="hero-desc">
      从 {firstYear} 年记到现在。生活里的片段、念头和照片，按时间收着。
    </p>
    <ul class="hero-stats">
      <li>
        <span class="stat-value">{blogs.length}</span>
        <span class="stat-label">篇日记</span>
      </li>
      <li>
        <span class="stat-value">{tags.length}</span>
        <span class="stat-label">个标签</span>
      </li>
      <li>
        <span class="stat-value">{lastUpdate}</span>
        <span class="stat-label">最近更新</span>
      </li>
    </ul>
    <ul class="tag-list">
      {
        popularTags.map((tag) => (
          <li>
            <a class="tag" href={`/tag/${tag}/`}>
              {tag}
              <span class="tag-count">{tagCounts[tag]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    featured && (
      <a class="feature reveal" href={featured.url}>
        {featured.img && (
          <div class="feature-media">
            <Image
              src={featured.img}
              width={1200}
              height={514}
              format="webp"
              alt=""
              loading="eager"
              fetchpriority="high"
              decoding="async"
              widths={[640, 960, 1200]}
              sizes="(max-width: 640px) 92vw, 864px"
            />
          </div>
        )}
        <div class="feature-body">
          <span class="feature-badge">最新</span>
          <h2 class="feature-title">{featured.post.data.title}</h2>
          {featured.desc && <p class="feature-desc">{featured.desc}</p>}
          <div class="feature-meta">
            {featured.post.data.pubDatetime
              ? dayjs(featured.post.data.pubDatetime).format("YYYY-MM-DD")
              : ""}
          </div>
        </div>
      </a>
    )
  }

  <h2 class="section-label reveal">更早</h2>
  <ul class="post-list">
    {
      posts.map(({ post, img, desc, url, priority }) => (
        <HorizontalCard
          title={post.data.title}
          img={img}
          desc={desc}
          url={url}
          badge={post.data.badge}
          tags={post.data.tags}
          pubDatetime={post.data.pubDatetime}
          priority={priority}
        />
      ))
    }
  </ul>

  <p style="margin-top:2rem">
    <a href="/blog/">查看全部 {blogs.length} 篇 →</a>
  </p>
</BaseLayout>
