---
import { CollectionEntry } from "astro:content";
import { BlogSchema } from "../../content/config";
import PostLayout from "../../layouts/PostLayout.astro";
import {getNotes} from "../../utils";
import getHeroImageLinkFromMd from "../../utils/getHeroImageLinkFromMd";

export async function getStaticPaths() {
  const postEntries = await getNotes();
    return postEntries.map((entry, idx) => {
        const prev = postEntries[idx - 1]
        const next = postEntries[idx + 1]
        return {
            params: { slug: entry.slug },
            props: { entry, next, prev },
        }
    });
}

interface Props {
  entry: CollectionEntry<"note">;
}

const { entry, prev, next } = Astro.props;
const post: BlogSchema = entry.data;
const heroImage = getHeroImageLinkFromMd(entry.body)
const hasCode = entry.body.includes("```");
const hasToc = /^#{2,6}\s/m.test(entry.body);
const hasArticleMedia = /!\[[^\]]*]\([^)]*\)|<img\b|<picture\b|<video\b|<iframe\b|!bv\{/i.test(entry.body);
const { Content } = await entry.render();
---

<PostLayout
  title={post.title}
  description={post.description}
  pubDatetime={post.pubDatetime}
  heroImage={heroImage}
  updatedDate={post.updatedDate}
  badge={post.badge}
  tags={post.tags}
  type = "note"
  hasCode={hasCode}
  hasToc={hasToc}
  hasArticleMedia={hasArticleMedia}
>
  <Content />
    <nav class="not-prose mt-12 grid gap-3 border-t border-base-300 pt-6 sm:grid-cols-2" aria-label="Post navigation">
        {
            prev ? (
                    <a href={`/note/${prev?.slug}/`} class="group rounded-lg border border-base-300 bg-base-100 p-4 no-underline transition hover:-translate-y-0.5 hover:border-base-content/20 hover:bg-base-200/50">
                        <span class="mb-1 block text-xs text-base-content/45">Previous</span>
                        <span class="flex items-center gap-2 text-sm font-semibold leading-6 text-base-content">
                            <svg class="h-5 w-5 shrink-0 fill-current transition group-hover:-translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
                            </svg>
                            <span class="line-clamp-2">{prev.data.title}</span>
                        </span>
                    </a>
            ) : (
                    <div />
            )
        }
        {
            next ? (
                    <a href={`/note/${next?.slug}/`} class="group rounded-lg border border-base-300 bg-base-100 p-4 text-right no-underline transition hover:-translate-y-0.5 hover:border-base-content/20 hover:bg-base-200/50">
                        <span class="mb-1 block text-xs text-base-content/45">Next</span>
                        <span class="flex items-center justify-end gap-2 text-sm font-semibold leading-6 text-base-content">
                            <span class="line-clamp-2">{next.data.title}</span>
                            <svg class="h-5 w-5 shrink-0 fill-current transition group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
                            </svg>
                        </span>
                    </a>
            ) : (
                    <div />
            )
        }
    </nav>
</PostLayout>
