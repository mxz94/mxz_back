---
import { getPublicAllPosts } from "../../../utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import Pagination from "@components/Pagination.astro";
import { buildPostListItems, groupPostsByTag } from "../../../utils/postList";

export async function getStaticPaths({ paginate }) {
  const allPosts = await getPublicAllPosts();
  const postsByTag = groupPostsByTag(allPosts);

  return Array.from(postsByTag, ([tag, taggedPosts]) =>
    paginate(taggedPosts, { params: { tag }, pageSize: 12 })
  ).flat();
}

const { page } = Astro.props;
const params = Astro.params;
const firstPage = page.url.prev ? `/tag/${params.tag}` : null;
const lastPage = page.url.next ? `/tag/${params.tag}/${page.lastPage}` : null;
const postItems = buildPostListItems(page.data);
---

<BaseLayout title={`标签 - ${params.tag}`}>
  <h1 class="page-title">{params.tag}</h1>
  <p class="page-desc">共 {page.total} 篇。</p>

  <ul class="post-list">
    {
      postItems.map(({ post, img, desc, url, priority }) => (
        <HorizontalCard
          title={post.data.title}
          img={img}
          desc={desc}
          url={url}
          badge={post.data.badge}
          tags={post.data.tags}
          pubDatetime={post.data.pubDatetime}
          priority={priority}
        />
      ))
    }
  </ul>

  {
    page.lastPage > 1 && (
      <Pagination
        firstPage={firstPage}
        previousPage={page.url.prev}
        nextPage={page.url.next}
        lastPage={lastPage}
        currentPage={page.currentPage}
        totalPages={page.lastPage}
      />
    )
  }

  <p style="margin-top:2rem"><a href="/tags/">← 全部标签</a></p>
</BaseLayout>
