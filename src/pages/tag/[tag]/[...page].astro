---
import { getAllPosts } from "../../../utils";
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import PageHeader from "@components/PageHeader.astro";
import suppDesc from "../../../utils/suppDesc";
import createSlug from "../../../utils/createSlug";
import Pagination from "../../../components/Pagination.astro";
import getHeroImageLinkFromMd from "../../../utils/getHeroImageLinkFromMd";

export async function getStaticPaths({ paginate }) {
  let all_posts = await getAllPosts();
  all_posts = all_posts.filter((item) => !item.data.auth);
  const all_tags = all_posts.flatMap((post) => {
    return post.data.tags || [];
  });

  return all_tags.flatMap((tag) => {
    const filtred_posts = all_posts.filter((post) => {
      return post.data.tags?.includes(tag);
    });
    return paginate(filtred_posts, {
      params: { tag },
      pageSize: 10,
    });
  });
}

const { page } = Astro.props;
const params = Astro.params;
const firstPage = page.url.prev ? `/tag/${params.tag}` : null;
const lastPage = page.url.next ? `/tag/${params.tag}/${page.lastPage}` : null;
let priorityImageCount = 0;
const postItems = page.data.map((post) => {
  const img = getHeroImageLinkFromMd(post);
  const priority = Boolean(img) && priorityImageCount < 2;
  if (img) priorityImageCount += 1;

  return { post, img, priority };
});
---

<BaseLayout title={"标签 - " + params.tag} sideBarActiveItemID="tags">
  <PageHeader title={`标签 - ${params.tag}`} description="同一个主题下的相关记录。" count={`${page.total} 篇`} />
  {
    page.data.length === 0 ? (
      <div class="rounded-lg border border-base-300 bg-base-100 p-5 text-base-content/70">
        <p class="font-semibold text-base-content">暂时还没有内容</p>
        <p class="mt-1 text-sm">之后再回来看看。</p>
      </div>
    ) : (
      <div class="space-y-3">
        {postItems.map(({ post, img, priority }) => (
          <HorizontalCard
            title={post.data.title}
            img={img}
            desc={suppDesc(post.data.description, post.body)}
            url={createSlug(post)}
            target="_self"
            badge={post.data.badge}
            tags={post.data.tags}
            priority={priority}
          />
        ))}
      </div>
    )
  }

  {
    page.lastPage > 1 && (
      <Pagination
        firstPage={firstPage}
        previousPage={page.url.prev}
        nextPage={page.url.next}
        lastPage={lastPage}
        currentPage={page.currentPage}
        totalPages={page.lastPage}
      />
    )
  }
</BaseLayout>
